#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    chosen {
        zephyr,console = &uart0;
        zephyr,shell-uart = &uart1;
    };
};

&i2c0 {
    accel0: accel@68 {
        compatible = "bosch,bmi160";
        reg = <0x68>;
    };
};

&uart1 {
    status = "okay";
};

